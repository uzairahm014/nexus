{
  "name": "nexus-platform",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS — play, create, connect, explore. Full-stack gaming, social and creator ecosystem.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --workspace server run build",
    "build:client": "npm --workspace client run build",
    "start": "node server/dist/index.js",
    "test": "npm run build:server && node --test --test-force-exit server/tests/",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck",
    "seed": "npm --workspace server run seed",
    "art": "bash scripts/build-art.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
