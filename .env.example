# ───────────────────────────── NEXUS environment ─────────────────────────────
# Copy to `.env` (root) for local development. Never commit real secrets.

# Public origin the API is reachable at (used in share links and CORS checks).
PUBLIC_ORIGIN=http://localhost:4000

# HTTP port for the Node API + WebSocket server.
PORT=4000

# 32+ random characters. Required in production — sessions are signed with it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# SQLite file location (created automatically). Mount a disk in production.
DATA_DIR=./server/data
# DB_PATH=./server/data/nexus.db

# Where uploaded clips, avatars and banners are written (12 MB per file cap).
UPLOAD_DIR=./uploads

# Set to 0 to skip the demo dataset on first boot.
SEED_ON_START=1

# Comma-separated extra origins allowed to call the API (Vercel preview URLs etc.).
# The deployed frontend origin is always allowed automatically.
EXTRA_ORIGINS=

# Frontend build-time API base. Leave empty when the API serves the built client
# from the same origin (the default AppJet/Docker deployment).
# For a split deploy (Vercel frontend + hosted API) set the full API URL:
# VITE_API_URL=https://your-api-host.example.com/api
VITE_API_URL=
